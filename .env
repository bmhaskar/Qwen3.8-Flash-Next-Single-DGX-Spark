# .env.sample — single-Spark (TP=1) deployment. Copy to .env and edit.
IMAGE="vllm/vllm-openai:qwen38-flash-next"
SERVED_MODEL_NAME="qwen3.8-flash-next"
# HF_TOKEN=""                       # only needed if the checkpoint is gated

# Known-good serving profile (measured 2026-09-04 on this host). Every value
# can be overridden from the environment: MAX_MODEL_LEN=65536 ./start.sh
YARN=0                              # 0 = native rope (uses MAX_MODEL_LEN), 1 = YaRN (uses YARN_MAX_MODEL_LEN)
MAX_MODEL_LEN=262144                # context at YARN=0; cannot exceed the native 262144
YARN_MAX_MODEL_LEN=524288           # context at YARN=1; ignored when YARN=0. Ceiling 524288
MTP_NUM_SPECULATIVE_TOKENS=3        # 0 disables MTP (saves 1.5 GiB)
KV_TARGET_GIB=16                    # KV wish, GiB (FP8: ~1M tokens, >3.5x a 262k request). It is
                                    # capped by HOST_RESERVE_GIB below; 16 sits just under the cap.
                                    # 22 (the old default) idled the host at 6.9-8.8 GiB MemAvailable
                                    # against a 6 GiB watchdog floor and the NVIDIA driver refused
                                    # allocations there: three servers lost on 2026-09-04.
HOST_RESERVE_GIB=26                 # GPU budget cap = MemTotal - this. Co-tenants ~7 + vLLM host side ~6 + PLE cache >=6 + driver free pages >=3 + growth
KV_CACHE_DTYPE=fp8                  # fp8 = ~1.85x KV pool, enables a 1M context.
                                    # Set to auto/bfloat16 for BF16 KV. Measured here:
                                    # Measured: -2.7% prefill @400k, -6.1% @32k, -4%
                                    # decode, 11/11 on the reasoning suite (same as BF16).
MAX_NUM_SEQS=4                      # concurrent sequences (see README for KV headroom). The KV
                                    # pool holds 3.79x a full 262k request, so this is the
                                    # long-context limit, not a throughput knob. Aggregate decode
                                    # keeps rising well past it on short contexts (measured
                                    # 2026-09-05: 84.7 tok/s at 5 streams, 114 at 8) but 8
                                    # concurrent 262k requests do not fit the KV pool.
CUDAGRAPH_CAPTURE_SIZES=auto        # decode CUDA graph widths. "auto" captures every (1+MTP)*S for
                                    # S in 1..MAX_NUM_SEQS -- i.e. every verify batch the scheduler
                                    # can actually build. vLLM's own list is [1,2,4]+multiples of 8
                                    # filtered to <= (1+MTP)*MAX_NUM_SEQS, which at MTP 3 leaves
                                    # keys {4,8,16}: a 3-sequence batch (12 tokens) pads up to 16
                                    # and a 5-sequence batch (20 tokens) has no graph at all and
                                    # decodes eager. Empty keeps vLLM's list. A comma list sets
                                    # them explicitly. Capture costs ~1 s and a few MiB per size.
MAX_NUM_BATCHED_TOKENS=2048         # prefill chunk width. Raising this to 8192 buys ~11% prefill
                                    # and ~10% off TTFT, paid for out of the KV pool (~3%).
                                    # See the README prefill table before changing it.
MTP_K_SCHEDULE=                      # dynamic speculative depth, "start:end:K,..." over inclusive
                                    # batch-size ranges (e.g. "1:2:3,3:5:2,6:8:1"). Empty keeps a
                                    # constant MTP_NUM_SPECULATIVE_TOKENS. WARNING, measured
                                    # 2026-09-05: setting this makes vLLM override cudagraph_mode
                                    # from FULL_DECODE_ONLY to PIECEWISE, which cost +24% on the
                                    # single-stream step and drove the driver to 99.4 GiB against a
                                    # 94.87 GiB budget until the watchdog stopped the server. Do
                                    # not enable without VLLM_USE_V2_MODEL_RUNNER=1 (untested).
COMPILATION_MODE=0                  # torch.compile level. 0 = none (shipped). 3 = VLLM_COMPILE
                                    # (Inductor fusion); adds minutes to the first launch and has
                                    # not been validated against the PLE custom op here.
HOST_SLACK_GIB=5                    # container cgroup cap = GPU budget + this
PORT=8888

MTP_DRAFT_VOCAB=files/draft_vocab_en_code_47k.txt   # merged upstream d038090; 47,149 rows,
                                    # draft head 1.18 -> 0.22 GiB, ~2.9 GiB saved per MTP-3 step.

# ---------------------------------------------------------------------------
# Fork-local, spark-bharat. Everything below is required by the pi client.
# ---------------------------------------------------------------------------
# THE PI FIX — do not remove. Both Flash-Next stacks enable reasoning by
# default, reasoning tokens count against max_tokens, and pi's internal
# context-compaction call sizes its budget for the answer only: on 2026-09-07
# reasoning ate the budget first and pi died with "Context overflow recovery
# failed: Summarization failed: generation hit the token cap" (20 of 36
# requests finished on `length`). Clients can still opt back in per request
# with chat_template_kwargs={"enable_thinking":true}.
#
# Until now this flag lived ONLY in .last_launch.sh line 30 and was typed
# inline on the 2026-09-13 start.sh launch, so any plain ./start.sh came up
# thinking-ON and reintroduced the bug. Persisted here 2026-09-20.
#
# QUOTING IS LOAD-BEARING. start.sh word-splits this with `read -ra` and does
# NOT honour quotes as grouping (start.sh:984), then joins the args and writes
# them through an UNQUOTED heredoc into .last_launch.sh, where the shell parses
# them once more. The literal single quotes survive the split (no whitespace
# inside the JSON) and are consumed by that second parse, so vLLM receives
# {"enable_thinking":false}. Without them the second parse eats the double
# quotes and vLLM gets {enable_thinking:false} — invalid JSON, thinking back
# on, bug back. Verified both ways before committing.
EXTRA_VLLM_ARGS="--default-chat-template-kwargs '{\"enable_thinking\":false}' --override-generation-config '{\"temperature\":0.7,\"top_p\":0.8,\"top_k\":20}'"

# Qwen publishes DIFFERENT sampling values for the two modes, and the
# checkpoint's generation_config.json carries the THINKING ones (temp 1.0,
# top_p 0.95) — vLLM applies them automatically and says so in the boot log.
# Serving thinking-off under thinking-on sampling is the combination the model
# card warns about ("language mixing and a slight decrease in model
# performance"); upstream observed it live. Instruct values are temp 0.7,
# top_p 0.80, top_k 20, and they are set by the --override-generation-config
# half of EXTRA_VLLM_ARGS above. Drop that flag alone to revert.
# The published instruct presence_penalty of 1.5 is NOT set, and cannot be set
# this way: vllm/config/model.py:1691 honours only repetition_penalty,
# temperature, top_k, top_p, min_p and max_new_tokens as generation_config
# defaults, so presence_penalty would be accepted and silently ignored. It
# would also be the wrong default here — it exists to break endless repetition
# in prose, and this box serves code, which is legitimately repetitive. A
# client that wants it can send it per request.
# Merge semantics verified in this image: model.py:1689 is
# config.update(override), so these three keys replace the checkpoint's and
# every other generation_config value survives. They are only DEFAULTS — any
# per-request value pi sends still wins.

# GDN recurrent-state dtype. The checkpoint asks for float32; the fused GDN
# kernel also takes bfloat16 (FUSED_GDN_STATE_DTYPES). Halves the ~0.23 GB per
# sequence the state moves every step AND halves the mamba page, dropping the
# attention block from 3,200 to 1,664 tokens — so it buys KV pool as well as
# decode. Upstream measured on a Spark: +6.8% decode at 1 stream, +8.5%
# aggregate at 8 (151.6 -> 164.5 tok/s), step 141.4 -> 130.4 ms, acceptance
# unchanged, needles 15/15 at 32k, no recurrence drift over 4 turns.
# UNMEASURED HERE until the A/B in logs/ab-code.jsonl says otherwise — empty
# restores the checkpoint's float32.
MAMBA_SSM_CACHE_DTYPE=bfloat16
